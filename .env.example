DATABASE_URL="postgresql://scout:scout_dev_password@localhost:5432/puntajes_scout_dev"

# Auth.js v5 — generá con: pnpm dlx auth secret
AUTH_SECRET=

# Google OAuth — creá en console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Requerido en producción (pnpm start) para que Auth.js acepte el host
AUTH_TRUST_HOST=true
